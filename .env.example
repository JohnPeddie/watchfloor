# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development. In Docker this is set to file:/app/data/watchfloor.db.
DATABASE_URL="file:./dev.db"

# Required on Windows ARM64 (Snapdragon) — Prisma ships no native ARM Windows
# library engine, so the query engine runs as a subprocess under emulation.
# Harmless elsewhere; the Linux container sets it for dev/prod parity.
PRISMA_CLIENT_ENGINE_TYPE="binary"

# ---------------------------------------------------------------------------
# Summarisation
# ---------------------------------------------------------------------------
# "rules"  — brief items are extractive too. Articles always use this engine.
# "ollama" / "openai" / "lmstudio" — local LLM writes daily brief items only.
# Falls back to "rules" automatically whenever the host cannot be reached.
SUMMARIZER="rules"

# Point this at whichever machine runs Ollama. Examples:
#   same machine                  http://127.0.0.1:11434
#   Docker host from a container   http://host.docker.internal:11434
#   another box on the LAN         http://192.168.1.50:11434
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Must already be pulled on the host (`ollama pull llama3.1:8b`).
OLLAMA_MODEL="llama3.1:8b"

# LM Studio (Developer → Start Server). Leave OPENAI_MODEL empty to use
# whatever is currently loaded. Paste the exact id from /v1/models to pin it.
OPENAI_BASE_URL="http://127.0.0.1:1234/v1"
OPENAI_MODEL=""
OPENAI_API_KEY="lm-studio"

# Per-request budget for brief composition. Raise it for larger / slower models.
OLLAMA_TIMEOUT_MS="120000"
LLM_TIMEOUT_MS="300000"

# Characters of article text sent to the model per request. Keep below the
# model's context window.
OLLAMA_CONTEXT_CHARS="6000"
LLM_CONTEXT_CHARS="6000"

# ---------------------------------------------------------------------------
# Deployment (docker compose reads these)
# ---------------------------------------------------------------------------
# Interface to publish on. 0.0.0.0 exposes to the LAN; 127.0.0.1 keeps it local.
WATCHFLOOR_BIND="0.0.0.0"
WATCHFLOOR_PORT="3050"

# Seconds between automatic collection cycles, and how many articles to
# re-summarise per cycle.
CYCLE_SECONDS="3600"
SUMMARIZE_BATCH="20"

TZ="Europe/London"
