# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development. Docker Compose overrides this to file:/app/data/watchfloor.db.
DATABASE_URL="file:./dev.db"

# Required on Windows ARM64 — Prisma ships no native ARM Windows library
# engine, so the query engine runs as a subprocess under emulation.
# Harmless elsewhere; the Linux container sets it for parity.
PRISMA_CLIENT_ENGINE_TYPE="binary"

# ---------------------------------------------------------------------------
# Summarisation — daily brief items, plus the optional per-article
# "why it matters" spark. Bulk article tagging stays on the rules engine.
# ---------------------------------------------------------------------------
# "rules"  — brief items are extractive too.
# "ollama" / "openai" / "lmstudio" — local LLM writes daily brief items
# and on-demand implications. Falls back to "rules" whenever the host cannot
# be reached. The dashboard keeps working and shows "LLM offline" until that
# machine is back.
SUMMARIZER="lmstudio"

# Point this at whichever machine runs Ollama. Examples:
#   same machine                  http://127.0.0.1:11434
#   Docker host from a container   http://host.docker.internal:11434
#   another box on the LAN         http://<llm-host>:11434
# Prefer a 3B-class model on small CPU hosts.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_MS="120000"

# LM Studio (Developer → Start Server). For local dev, loopback is fine.
# For a remote dashboard, set the LLM host in .env from deploy/site.env.example.
OPENAI_BASE_URL="http://127.0.0.1:1234/v1"
OPENAI_MODEL=""
OPENAI_API_KEY="lm-studio"
LLM_TIMEOUT_MS="300000"

# Characters of article text sent to the model per request. Keep below the
# model's context window.
OLLAMA_CONTEXT_CHARS="6000"
LLM_CONTEXT_CHARS="6000"

# ---------------------------------------------------------------------------
# Deployment (docker compose reads these)
# ---------------------------------------------------------------------------
# Interface to publish on. 0.0.0.0 exposes to the LAN; 127.0.0.1 keeps it local.
WATCHFLOOR_BIND="0.0.0.0"
WATCHFLOOR_PORT="3050"

# Only used if you start Compose with --profile legacy-cron. Prefer the in-app
# scheduler (Settings, next to the theme toggle) instead.
CYCLE_SECONDS="3600"

TZ="UTC"

# LAN IPs of the Docker host, rewritten to host.docker.internal from inside
# the container. Comma-separated. Leave blank if unused.
WATCHFLOOR_HOST_IPS=""
