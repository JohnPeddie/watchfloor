# Copy this file to .env in the repo root, then replace every YOUR_* value.
#
#   cp deploy/site.env.example .env
#
# .env is gitignored. Do not commit a filled copy.
# scripts/deploy.sh will refuse to start until the placeholders are gone.

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
WATCHFLOOR_BIND=0.0.0.0
WATCHFLOOR_PORT=3050
TZ=UTC

# ---------------------------------------------------------------------------
# Local LLM
# ---------------------------------------------------------------------------
# rules | lmstudio | ollama
SUMMARIZER=lmstudio

# Host that runs LM Studio. Use a hostname or LAN address — never commit the
# real one. Example: http://10.0.0.20:1234/v1
OPENAI_BASE_URL=http://YOUR_LLM_HOST:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=lm-studio
LLM_TIMEOUT_MS=300000

# Ollama on the same machine as Docker: host.docker.internal reaches the host.
# Bind Ollama on 0.0.0.0:11434, not only loopback.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000

# LAN addresses of the Docker host. From inside the container those IPs are
# hairpin NAT; Watchfloor rewrites them to host.docker.internal.
# Comma-separated. Leave blank if unused.
WATCHFLOOR_HOST_IPS=

# ---------------------------------------------------------------------------
# Ship from a development machine (scripts/ship.ps1)
# ---------------------------------------------------------------------------
WATCHFLOOR_SERVER=YOUR_SERVER
WATCHFLOOR_SSH_USER=YOUR_SSH_USER
WATCHFLOOR_REMOTE_DIR=~/watchfloor
