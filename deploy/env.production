# Production values for the Linux home server at 192.168.8.69.
# Copy to .env next to docker-compose.yml (that file is gitignored).
#
#   cp deploy/env.production .env

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
WATCHFLOOR_BIND=0.0.0.0
WATCHFLOOR_PORT=3050
TZ=Europe/London

# ---------------------------------------------------------------------------
# Local LLM — workstation at 192.168.8.60, not this server
# ---------------------------------------------------------------------------
# LM Studio on the workstation, until you switch to Ollama in Settings.
# Settings → Local LLM overrides SUMMARIZER and the host URL without a rebuild.
SUMMARIZER=lmstudio
OPENAI_BASE_URL=http://192.168.8.60:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=lm-studio
LLM_TIMEOUT_MS=300000

# Used when Settings is set to Ollama and the host field is left blank.
# From Docker, host.docker.internal is this server. Ollama must listen on
# 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434), not only localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=120000
