# Production values for the Linux home server at 192.168.8.69.
# Copy to .env next to docker-compose.yml (that file is gitignored).
#
#   cp deploy/env.production .env

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
WATCHFLOOR_BIND=0.0.0.0
WATCHFLOOR_PORT=3050
TZ=Europe/London

# ---------------------------------------------------------------------------
# Local LLM — workstation at 192.168.8.60, not this server
# ---------------------------------------------------------------------------
# LM Studio Developer server on the PC. Leave OPENAI_MODEL empty to use
# whatever is currently loaded. If that PC is off, Watchfloor still runs and
# daily briefs fall back to the rules engine.
SUMMARIZER=lmstudio
OPENAI_BASE_URL=http://192.168.8.60:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=lm-studio
LLM_TIMEOUT_MS=300000

# Unused while SUMMARIZER=lmstudio. Harmless to leave.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=120000
